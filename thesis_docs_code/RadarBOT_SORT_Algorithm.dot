digraph RadarBOT_SORT_Algorithm {
    rankdir=TB;  // Top-to-bottom layout for narrower width
    node [shape=box, style=filled, fillcolor=lightblue, fontsize=12, fontname="Arial"];
    edge [arrowsize=1.2, color=gray];

    // Inputs
    PredictedTracks [label="Predicted Tracks", fillcolor=palegreen];
    Detections [label="Detections", fillcolor=palegreen];

    // Cost Matrix After Inputs
    CostMatrix [label="Cost Matrix\nComputation", fillcolor=lightyellow];
    
    // First Gating (Before Hungarian)
    GatingPre [shape=diamond, label="Gating\n(Confidence &\nDistance)", fillcolor=orange, height=0.8, width=0.8];

    // Hungarian Assignment
    Hungarian [label="Hungarian Algorithm\nOptimal Assignment", fillcolor=lightyellow];

    // Second Gating (After Hungarian)
    GatingPost [shape=diamond, label="Gating\n(Confidence\nDecision)", fillcolor=orange, height=0.8, width=0.8];

    // Outcomes
    Valid [label="Valid\nAssignments", fillcolor=lightblue];
    KalmanUpdate [label="Kalman Update", fillcolor=lightblue];
    Invalid [label="Invalid\nAssignments", fillcolor=lightblue];
    TrackAging [label="Track Aging &\nTermination", fillcolor=pink];
    Unmatched [label="Unmatched\nDetections", fillcolor=lightblue];
    NewTrack [label="New Track Init", fillcolor=lightblue];

    // Our Contribution Cluster (Single Box with Internal Blocks)
    subgraph cluster_our_contribution {
        label="Our Contribution";
        style=filled;
        fillcolor=lightcyan;
        color=blue;
        fontcolor=blue;
        penwidth=2;

        Confidence [label="Confidence Integration", fillcolor=lightcoral];
        AdaptiveR [label="Adaptive R Matrix\nin Kalman Filter", fillcolor=lightcoral];
        StatisticalAssociation [label="Statistical Association", fillcolor=lightcoral];
        RadarFeatures [label="Radar-Specific Features", fillcolor=lightcoral];
    }

    // Updated Connections
    {rank=same; PredictedTracks Detections};
    PredictedTracks -> CostMatrix;
    Detections -> CostMatrix;
    CostMatrix -> GatingPre [label="Compute Costs"];
    GatingPre -> Hungarian [label="Pass", color=green];
    Hungarian -> GatingPost [label="Assignments"];
    GatingPost -> Valid [label="Valid", color=green];
    Valid -> KalmanUpdate;
    GatingPost -> Invalid [label="Invalid", color=red];
    Invalid -> TrackAging;
    GatingPost -> Unmatched [label="Unmatched"];
    Unmatched -> NewTrack;

    // Attach Contributions to Process (Dotted Lines)
    GatingPre -> Confidence [dir=none, style=dotted, color=red];
    CostMatrix -> Confidence [dir=none, style=dotted, color=red];
    GatingPost -> Confidence [dir=none, style=dotted, color=red];
    CostMatrix -> StatisticalAssociation [dir=none, style=dotted, color=red];
    KalmanUpdate -> AdaptiveR [dir=none, style=dotted, color=red];
    CostMatrix -> AdaptiveR [dir=none, style=dotted, color=red];
    CostMatrix -> RadarFeatures [dir=none, style=dotted, color=red];

    {rank=same; Valid Invalid Unmatched};
}